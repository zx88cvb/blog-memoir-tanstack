# Local development:
#   cp env.example .env.development   # then fill in the values below
#
# Loader priority (scripts/with-env.ts + vite loadEnvFiles):
#   .env.local > .env.{NODE_ENV} > .env
# So in dev, .env.development is picked up by both `pnpm dev` and the db scripts.
#
# Keep this file minimal: provider credentials (payments, OAuth, email,
# storage, AI) are configured in the admin panel → Settings and
# stored in the database (encrypted when CONFIG_ENCRYPTION_KEY is set).
# Env vars with the matching names still work as fallbacks — database values
# take precedence — but they don't need to live in this template.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
VITE_APP_URL=http://localhost:3000
VITE_APP_NAME=tanstack-template
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Extra origins allowed to call the auth API (comma-separated). A leading dot
# is a hostname-suffix wildcard, e.g. `.e2b.app` for cloud-sandbox previews.
AUTH_TRUSTED_ORIGINS=

# ---------------------------------------------------------------------------
# App (optional — sensible defaults exist in src/config/index.ts)
# ---------------------------------------------------------------------------
VITE_APP_DESCRIPTION=desc
VITE_APP_LOGO=/logo.png
VITE_DEFAULT_LOCALE=en
# Default theme: light | dark | system (saved user preference takes priority)
VITE_DEFAULT_THEME=light

# Google Analytics 4 (production only). Set empty to disable tracking.
# Read on the server and exposed through getAnalyticsConfigs.
GOOGLE_ANALYTICS_ID=