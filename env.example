# Development only. Production builds must use https://haydenbi.com.
VITE_APP_URL=http://localhost:3000
VITE_APP_NAME="Hayden Bi Blog"
VITE_APP_DESCRIPTION="Hayden Bi 的长篇笔记、部署记录和实验合集，探索独立开发与出海产品经验。"
VITE_APP_LOGO=/logo.png
VITE_DEFAULT_LOCALE=zh-cn
# light | dark | system; the user's saved theme takes priority.
VITE_DEFAULT_THEME=light

# Public, build-time configuration. Reuse the old Waline service for comments.
# NEXT_PUBLIC_WALINE_SERVER_URL -> VITE_WALINE_SERVER_URL
VITE_WALINE_SERVER_URL=
# NEXT_PUBLIC_TWITTER_SITE -> VITE_TWITTER_SITE
VITE_TWITTER_SITE=@HaydenBi
# STORE_PUBLIC_SITE_URL -> VITE_STORE_PUBLIC_URL
# When empty, share images fall back to the existing /logo.png.
VITE_STORE_PUBLIC_URL=

# Server runtime, production only. NEXT_PUBLIC_GA_ID -> GOOGLE_ANALYTICS_ID
GOOGLE_ANALYTICS_ID=
