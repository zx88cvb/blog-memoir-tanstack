{
  "name": "blog-memoir-tanstack",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "format": "biome format",
    "lint": "biome lint",
    "i18n:generate": "paraglide-js compile --project ./project.inlang",
    "check": "biome check",
    "check:i18n": "inlang check --project ./project.inlang --source ./src --missing-translations --empty-translations --empty-variants --missing-variables --unknown-variables --missing-markup --missing-variants --missing-selectors",
    "machine-translate": "inlang machine translate --project project.inlang",
    "test:migration": "node --experimental-strip-types --test scripts/migration.test.ts",
    "test:content": "node --experimental-strip-types --test scripts/markdown.test.ts scripts/post.test.ts scripts/pagination.test.ts scripts/clipboard.test.ts scripts/i18n.test.ts",
    "test:watch": "node --experimental-strip-types --test scripts/watch-content.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "0.10.13",
    "@tanstack/react-query": "5.104.2",
    "@tanstack/react-query-devtools": "5.104.2",
    "@tanstack/react-router": "1.170.44",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.2",
    "@tanstack/router-core": "1.171.37",
    "@waline/client": "3.8.0",
    "aws4fetch": "^1.0.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "feed": "^6.0.0",
    "lucide-react": "^1.54.0",
    "markdown-it": "^15.0.3",
    "nitro": "3.0.260610-beta",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "simple-flakeid": "^0.0.5",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.1.18",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@content-collections/core": "^0.15.3",
    "@content-collections/vite": "^0.3.1",
    "@inlang/cli": "^3.4.0",
    "@inlang/paraglide-js": "^2.27.0",
    "@shikijs/markdown-it": "^4.5.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "github-slugger": "^2.0.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "zod": "^4.6.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ],
    "overrides": {
      "@tanstack/router-core": "1.171.37"
    }
  }
}
